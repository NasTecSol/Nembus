{
  "uid": "nembus-biometric-agent",
  "title": "04 - Nembus Biometric Agent",
  "tags": [
    "nembus",
    "biometric-agent",
    "hardware",
    "edge"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(target_info{service_name=\"nembus-biometric-agent\"}, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_slug",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(http_server_requests_total{service_name=\"nembus-biometric-agent\"}, nembus_tenant_slug)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online Biometric Bridges (3m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(last_over_time(target_info{service_name=\"nembus-biometric-agent\", deployment_environment=~\"$environment\"}[3m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connected Scanners Reported",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nembus_biometric_devices_connected{deployment_environment=~\"$environment\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Successful Captures (1h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nembus_biometric_captures_total{deployment_environment=~\"$environment\", status=\"ok\"}[1h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Capture Errors / Timeouts (1h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nembus_biometric_captures_total{deployment_environment=~\"$environment\", status=~\"error|timeout\"}[1h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fingerprint Captures by Outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(nembus_biometric_captures_total{deployment_environment=~\"$environment\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Capture & Bridge HTTP P95 Latency (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Capture P95 ms",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nembus_biometric_capture_duration_ms_bucket{deployment_environment=~\"$environment\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "Bridge HTTP P95 ms",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_ms_bucket{service_name=\"nembus-biometric-agent\", deployment_environment=~\"$environment\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Biometric Agent Logs",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"nembus-biometric-agent\", deployment_environment=~\"$environment\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Biometric Bridge Traces",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"nembus-biometric-agent\" }",
          "limit": 25
        }
      ]
    }
  ]
}
