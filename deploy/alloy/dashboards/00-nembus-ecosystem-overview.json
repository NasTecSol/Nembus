{
  "uid": "nembus-ecosystem-overview",
  "title": "00 - Nembus Ecosystem Overview",
  "tags": [
    "nembus",
    "observability",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(target_info, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_slug",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(http_server_requests_total, nembus_tenant_slug)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Nembus Services",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (service_name) (last_over_time(target_info{deployment_environment=~\"$environment\"}[3m])))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ecosystem Request Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 5xx Error Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", status_class=\"500\"}[5m])) or vector(0)) / clamp_min((sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m])) or vector(0)), 0.001) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active POS Outbox Pending",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nembus_pos_outbox_pending_rows{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 HTTP Latency by Service",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_ms_bucket{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cross-App Sync & ETL Throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "gRPC {{service_name}} {{direction}} ({{status}})",
          "expr": "sum by (service_name, direction, status) (rate(nembus_sync_events_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m]))"
        },
        {
          "refId": "B",
          "legendFormat": "SAP ETL rows ({{status}})",
          "expr": "sum by (status) (rate(nembus_sap_etl_rows_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tempo Service Graph Request Rate (Edge -> Cloud)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{client}} -> {{server}}",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent Error & Warning Logs (All Nembus Services)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"nembus-.*\", deployment_environment=~\"$environment\"} | detected_level=~\"error|warn\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent Slow or Failed Distributed Traces",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error || duration > 500ms }",
          "limit": 20
        }
      ]
    }
  ]
}
