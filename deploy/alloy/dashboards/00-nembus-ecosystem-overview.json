{
  "uid": "nembus-ecosystem-overview",
  "title": "00 - Nembus Ecosystem Overview",
  "tags": [
    "nembus",
    "observability",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(target_info{service_namespace=\"nembus\"}, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_slug",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(http_server_requests_total, nembus_tenant_slug)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online Service Instances (5m)",
      "description": "Unique Nembus service instances reporting telemetry in the last 5 minutes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (service_name, service_instance_id) (last_over_time(target_info{service_namespace=\"nembus\", deployment_environment=~\"$environment\"}[5m]))) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Real API RPS (excl. /health)",
      "description": "Combined API request rate across all Nembus apps, excluding health checks and static UI polling.",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\"}[$__rate_interval])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 5xx Error %",
      "description": "",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\", status_class=\"500\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\"}[$__rate_interval])), 0.0001)) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP 4xx Errors (1h)",
      "description": "",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\", status_class=\"400\"}[1h])) or vector(0))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "POS Outbox Pending Rows",
      "description": "",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nembus_pos_outbox_pending_rows{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Connected Nembus Fleet (Last 10m)",
      "description": "Every Nembus service instance active within the last 10 minutes.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "service_name": "Service",
              "service_instance_id": "Instance / Host",
              "service_version": "Version",
              "deployment_environment": "Environment"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "count by (service_name, service_instance_id, service_version, deployment_environment) (last_over_time(target_info{service_namespace=\"nembus\", deployment_environment=~\"$environment\"}[10m]))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Real HTTP Request Rate by Service (excl. /health & UI polling)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "P95 HTTP Latency by Service (ms)",
      "description": "95th percentile HTTP latency per service (excluding health checks & static assets).",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_ms_milliseconds_bucket{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} P95"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP Errors by Service & Status Class (Count)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, status_class) (increase(http_server_requests_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/|/app[.]js|/style[.]css|/favicon[.]ico|/api/v1/sync/status|/api/v1/migration/status|/api/v1/logs|/api/v1/onboarding/status|/api/v1/updates/check|/api/notifications/unread-count\", status_class=~\"400|500\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{status_class}}xx"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cross-App Sync & SAP ETL Volume (Events / Rows)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, direction, status) (increase(nembus_sync_events_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]))",
          "legendFormat": "gRPC {{service_name}} {{direction}} ({{status}})"
        },
        {
          "refId": "B",
          "expr": "sum by (direction, status) (increase(nembus_sap_etl_rows_total{deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]))",
          "legendFormat": "SAP ETL {{direction}} ({{status}})"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent Error & Warning Logs (All Nembus Services)",
      "description": "Live error and warning logs across Cloud Server, POS Client, SAP Agent, and Biometric Agent.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"nembus-.*\", deployment_environment=~\"$environment\"} |~ \"(?i)error|warn|fail|panic|exception|quarantin|❌|⚠️\""
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Slow or Failed Distributed Traces (>250ms or Error, excl. /health)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceqlSearch",
          "query": "{ resource.service.namespace = \"nembus\" && name != \"GET /health\" && (status = error || duration > 250ms) }",
          "limit": 25
        }
      ]
    }
  ]
}
