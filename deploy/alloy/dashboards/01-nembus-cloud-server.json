{
  "uid": "nembus-cloud-server",
  "title": "01 - Nembus Cloud Server",
  "tags": [
    "nembus",
    "cloud-server",
    "api",
    "postgres"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(target_info{service_name=\"nembus-cloud-server\"}, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_slug",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(http_server_requests_total{service_name=\"nembus-cloud-server\"}, nembus_tenant_slug)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API RPS (excl. /health)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx %",
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\", status_class=\"500\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval])), 0.0001)) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 4xx Count (1h)",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\", status_class=\"400\"}[1h])) or vector(0))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P95 API Latency",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]))) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active WebSocket Clients",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nembus_websocket_clients_active{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "ZATCA Errors (1h)",
      "description": "",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(nembus_zatca_submissions_total{app=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", status=\"error\"}[1h])) or vector(0))",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Request Latency Quantiles (ms, excl. /health)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 Slowest API Endpoints (P95 ms)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_request_method": "Method",
              "http_route": "Route",
              "Value": "P95 (ms)"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]) or rate(http_server_request_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]))))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Failing API Endpoints (4xx & 5xx Count in 1h)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_request_method": "Method",
              "http_route": "Route",
              "http_response_status_code": "Status",
              "nembus_tenant_slug": "Tenant",
              "Value": "Errors (1h)"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, round(sum by (http_request_method, http_route, http_response_status_code, nembus_tenant_slug) (increase(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\", status_class=~\"400|500\"}[1h])) > 0))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API Requests by Tenant (excl. /health)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (nembus_tenant_slug) (rate(http_server_requests_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\", http_route!~\"/health|/swagger.*|/metrics|/favicon\\.ico|/api/notifications/unread-count\"}[$__rate_interval]))",
          "legendFormat": "{{nembus_tenant_slug}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostgreSQL Query P95 Latency by DB Role (ms)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, nembus_db_role) (rate(db_client_operation_duration_ms_milliseconds_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]) or rate(db_client_operation_duration_ms_bucket{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval])))",
          "legendFormat": "DB P95 {{nembus_db_role}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PostgreSQL Pool Usage & Query Errors",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool_name) (db_client_connections_usage{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\"})",
          "legendFormat": "Acquired {{pool_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (nembus_db_role) (increase(db_client_operation_errors_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]))",
          "legendFormat": "DB Errors {{nembus_db_role}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "gRPC Sync Records (Push / Pull Counts)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, entity_type, status) (increase(nembus_sync_events_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} {{entity_type}} ({{status}})"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "ZATCA Submissions & Outbound Notifications (Counts)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(nembus_zatca_submissions_total{app=\"nembus-cloud-server\", deployment_environment=~\"$environment\", nembus_tenant_slug=~\"$tenant_slug\"}[$__rate_interval]))",
          "legendFormat": "ZATCA {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (channel, status) (increase(nembus_notifications_dispatched_total{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "Notify {{channel}} ({{status}})"
        }
      ]
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Cloud Server Logs (Loki)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"nembus-cloud-server\", deployment_environment=~\"$environment\"}"
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Cloud Server Distributed Traces (excl. /health)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceqlSearch",
          "query": "{ resource.service.name = \"nembus-cloud-server\" && name !~ \"GET (/health|/api/notifications/unread-count)\" }",
          "limit": 25
        }
      ]
    }
  ]
}
