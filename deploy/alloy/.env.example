# Copy to .env and fill from Grafana Cloud → your stack → OpenTelemetry → Configure
# https://grafana.com/docs/grafana-cloud/send-data/otlp/send-data-otlp/

# Full OTLP URL including /otlp (example region; use YOUR stack value)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp

# Numeric "Instance ID" on the OpenTelemetry tile (Basic auth username)
GRAFANA_CLOUD_INSTANCE_ID=123456

# Access policy token with metrics:write, logs:write, traces:write (password)
GRAFANA_CLOUD_API_KEY=glc_eyJv...