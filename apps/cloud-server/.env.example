# ==============================================================================
# Nembus Cloud Server Environment Configuration
# ==============================================================================

# Master Database URL (stores tenant metadata and connection strings)
MASTER_DB_URL=postgres://postgres:root1234@localhost:5432/nembus_e2e_master?sslmode=disable
# Cloud Server HTTP Port
PORT=8081
# JWT Secret for authentication
JWT_SECRET=devsecret
# gRPC Backup Service Port
GRPC_PORT=50051

# Environment: development, staging, production
ENV=development
LOG_LEVEL=debug

# ZATCA Phase 2 Configuration (Saudi Arabia compliance)
ZATCA_ENABLED=false
ZATCA_ENV=sandbox
ZATCA_ORG_VAT_ID=300000000000003
