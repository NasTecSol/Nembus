# ==============================================================================
# Nembus POS Client Environment Configuration
# ==============================================================================

ENV=development
PORT=8080

# Master Database URL
MASTER_DB_URL=postgres://root:nastecsol@localhost:5432/nembus?sslmode=disable

# Tenant / App Database URL:
# 1. Cloud AWS RDS:
DATABASE_URL=postgresql://postgres:<password>@nembus-pg-db.cf86sus6qqzy.us-east-2.rds.amazonaws.com:5432/postgres?sslmode=require
# 2. Local Fallback:
# DATABASE_URL=postgres://root:nastecsol@localhost:5432/nembus?sslmode=disable

JWT_SECRET=nastecsol
DEV_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_LOGIN=dev_user
LOG_LEVEL=debug

# Backup Service Settings
BACKUP_AUTH_TOKEN=nembus
BACKUP_SERVER_ADDR=nembus.nashrms.com:50051
CLOUD_URL=https://nembus.nashrms.com
GRPC_SERVER_ADDR=nembus.nashrms.com:50051

# ── ZATCA Configuration ────────────────────────────
ZATCA_ENABLED=false
ZATCA_ENV=sandbox
ZATCA_ORG_VAT_ID=300000000000003
