# ==============================================================================
# SAP-to-Nembus Sync Agent Configuration
# ==============================================================================

# --- SAP Business One (Service Layer REST API) ---
SAP_SL_URL=https://192.168.1.90:50000/b1s/v1
SAP_COMPANY_DB=QITAFALAELAHLTD
SAP_USERNAME=manager
SAP_PASSWORD=your_sap_password
SAP_INSECURE_SKIP_VERIFY=true

# --- SAP Direct MSSQL Extraction (Optional Fallback / High-volume read) ---
SAP_MSSQL_ENABLED=false
SAP_MSSQL_HOST=192.168.1.90
SAP_MSSQL_PORT=1433
SAP_MSSQL_DATABASE=QITAFALAELAHLTD
SAP_MSSQL_USER=sa
SAP_MSSQL_PASSWORD=abs@123

# --- Nembus Connection ---
# Local POS Client Embedded Postgres (port 5433) or Cloud Server Postgres (port 5432)
NEMBUS_DB_URL=postgres://postgres:password@localhost:5433/nembus?sslmode=disable
NEMBUS_API_URL=http://localhost:8080/api/v1
NEMBUS_API_TOKEN=

# --- Mapping & Scope ---
NEMBUS_ORGANIZATION_ID=1
NEMBUS_STORE_ID=1
NEMBUS_PRICE_LIST_ID=1
NEMBUS_DEFAULT_CUSTOMER_CODE=C000001
NEMBUS_TAX_CATEGORY_ID=1
NEMBUS_DEFAULT_WAREHOUSE_CODE=01

# --- Sync & Schedule Settings ---
# Downstream: SAP -> Nembus Master Data (interval in seconds, e.g. 300 = 5 min)
DOWNSTREAM_INTERVAL_SECONDS=300

# Upstream: Nembus POS -> SAP Transactions Outbox watcher (interval in milliseconds)
UPSTREAM_OUTBOX_POLL_MS=3000

# Maximum items to process in single batch
BATCH_SIZE=100

# Dry Run: true = simulate and log without committing to target
DRY_RUN=false
